{
  "family": "gcs-erp-production",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/gcsErpTaskRole",
  "containerDefinitions": [
    {
      "name": "gcs-erp-api",
      "image": "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/gcs-erp-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/api/v1/health/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 40
      },
      "environment": [
        { "name": "DJANGO_SETTINGS_MODULE", "value": "config.settings" },
        { "name": "DEBUG", "value": "False" },
        { "name": "USE_SES", "value": "True" },
        { "name": "AWS_SES_REGION_NAME", "value": "ap-south-1" },
        { "name": "AWS_S3_REGION_NAME", "value": "ap-south-1" },
        { "name": "AWS_STORAGE_BUCKET_NAME", "value": "gcs-erp-certificates-production" }
      ],
      "secrets": [
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:gcs-erp/secret-key" },
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:gcs-erp/database-url" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:gcs-erp/redis-url" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/gcs-erp-production",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "api"
        }
      }
    },
    {
      "name": "gcs-erp-celery-worker",
      "image": "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/gcs-erp-api:latest",
      "essential": true,
      "command": ["celery", "-A", "config", "worker", "--loglevel=INFO", "--concurrency=2"],
      "environment": [
        { "name": "DJANGO_SETTINGS_MODULE", "value": "config.settings" },
        { "name": "DEBUG", "value": "False" },
        { "name": "AWS_S3_REGION_NAME", "value": "ap-south-1" },
        { "name": "AWS_STORAGE_BUCKET_NAME", "value": "gcs-erp-certificates-production" }
      ],
      "secrets": [
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:gcs-erp/secret-key" },
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:gcs-erp/database-url" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:gcs-erp/redis-url" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/gcs-erp-production",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}

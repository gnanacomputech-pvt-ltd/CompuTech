# GCS ERP Environment Variables Configuration
# Production Architecture Specification — AWS Deployment (ECS Fargate + RDS Multi-AZ)

# ============================================================================
# Security & Core Django
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
DEBUG=False
# Production hosts (explicit allowlist — no wildcards in production)
ALLOWED_HOSTS=api.gnanacomputech.com,verify.gnanacomputech.com,gnanacomputech.com

# CSRF Trusted Origins (exact production frontend origins)
CSRF_TRUSTED_ORIGINS=https://gnanacomputech.com,https://www.gnanacomputech.com

# Security Headers
SECURE_HSTS_SECONDS=31536000  # 1 year; set 0 for local dev
SECURE_SSL_REDIRECT=True

# ============================================================================
# Database — Amazon RDS PostgreSQL 16 Multi-AZ (behind RDS Proxy)
# ============================================================================
# Format: postgresql://<username>:<password>@<rds-proxy-endpoint>:5432/<dbname>
# Note: In production, credentials are injected via AWS Secrets Manager → ECS task env vars
# Local dev: omit or leave empty to use SQLite fallback
DATABASE_URL=postgresql://gcs_admin:secure_db_password_here@db:5432/gcs_erp_production

# Enable RDS Proxy connection pooling (disable Django-side pooling)
RDS_PROXY_ENABLED=True

# ============================================================================
# Redis — Amazon ElastiCache (Celery Broker, Result Backend, Session Cache)
# ============================================================================
# Format: redis://<endpoint>:6379/0  (in-cluster, no TLS)
#         rediss://<endpoint>:6379/0 (ElastiCache with in-transit encryption)
REDIS_URL=redis://redis:6379/0

# ============================================================================
# AWS S3 Object Storage (Certificates, Media, Uploads)
# ============================================================================
# S3 bucket for all user-uploaded files and generated certificates
AWS_STORAGE_BUCKET_NAME=gcs-erp-certificates-production
# AWS credentials: PREFERRED — use IAM task role (no static keys in env)
# If using IAM role, leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
# CloudFront CDN domain for media files (optional but recommended)
AWS_S3_CUSTOM_DOMAIN=d111111abcdef8.cloudfront.net
# S3-compatible endpoint (only for R2/MinIO/LocalStack; empty for AWS S3)
AWS_S3_ENDPOINT_URL=
# Use IAM role for S3 access (recommended on ECS Fargate)
AWS_USE_IAM_ROLE_FOR_S3=True

# Legacy Cloudflare R2 aliases (recognized if set):
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=

# ============================================================================
# JWT Configuration (djangorestframework-simplejwt)
# ============================================================================
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ============================================================================
# CORS Configuration — Frontend Client Origins
# ============================================================================
# Production: only https://gnanacomputech.com and https://www.gnanacomputech.com
# Dev: add localhost:3000, 127.0.0.1:3000, localhost:5173
CORS_ALLOWED_ORIGINS=https://gnanacomputech.com,https://www.gnanacomputech.com

# ============================================================================
# Sentry Error Monitoring
# ============================================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# ============================================================================
# Email — AWS SES (recommended) or SMTP Fallback
# ============================================================================
USE_SES=True
AWS_SES_REGION_NAME=ap-south-1
# SES SMTP credentials (create in SES console; stored in AWS Secrets Manager)
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=

# Standard SMTP fallback (if USE_SES=False):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@gnanacomputech.com
SERVER_EMAIL=noreply@gnanacomputech.com

# ============================================================================
# Business Logic Constants
# ============================================================================
MINIMUM_ATTENDANCE_PERCENTAGE=75.0

# ============================================================================
# App-Level Rate Limiting (supplements AWS WAF rate-based rules)
# ============================================================================
THROTTLE_USER_RATE=1000/hour
THROTTLE_ANON_RATE=100/hour

# ============================================================================
# Backup Encryption Key (AES-256-CBC for pg_dump export to S3)
# Generate: openssl rand -hex 32
# ============================================================================
BACKUP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# ============================================================================
# AWS / ECS Runtime (injected by ECS task definition / Secrets Manager)
# ============================================================================
# AWS_DEFAULT_REGION=ap-south-1
# GIT_COMMIT_SHA=abcdef123456
# AWS_EXECUTION_ENV=AWS_ECS_FARGATE

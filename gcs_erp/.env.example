# GCS ERP Environment Variables Configuration
# Production Architecture Specification (Hostinger VPS Deployment)

# Security & Core Django
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=gnanacomputech.com,api.gnanacomputech.com,verify.gnanacomputech.com,localhost,127.0.0.1

# Database (PostgreSQL 16 on Hostinger VPS Docker container)
# Leave empty or omit in local dev to automatically fallback to local SQLite
DATABASE_URL=postgresql://gcs_admin:secure_db_password_here@db:5432/gcs_erp_production

# Redis (Celery Broker & Cache)
REDIS_URL=redis://redis:6379/0

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=gcs-erp-certificates
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# JWT Configuration
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Frontend Client Origins (CORS)
CORS_ALLOWED_ORIGINS=https://gnanacomputech.com,https://verify.gnanacomputech.com,http://localhost:3000

# Sentry Monitoring (Section 2 & 10)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# Email Configuration (for password reset, fee reminders, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@gnanacomputech.com

# Business Logic Constants
MINIMUM_ATTENDANCE_PERCENTAGE=75.0

# App-Level Rate Limiting (Section 9)
THROTTLE_USER_RATE=1000/hour
THROTTLE_ANON_RATE=100/hour

# Backup Encryption Key (for scripted pg_dump AES-256-CBC backup)
BACKUP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

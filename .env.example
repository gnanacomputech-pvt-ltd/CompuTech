# Frontend build-time config (Vite only exposes vars prefixed VITE_).
# Copy to .env.local for local dev; in CI/CD this is set as a GitHub secret
# consumed by .github/workflows/deploy-frontend.yml at build time — because
# it's baked into the static bundle at build, not read at runtime, changing
# it requires a rebuild + redeploy, not just an env var change.

# Local dev: point at your local Django server (see gcs_erp/docker/docker-compose.yml)
VITE_API_BASE_URL=http://localhost:8000

# Production: the API's own origin (infra/aws output `api_url` — api.<domain>
# once DNS is configured, or the plain-HTTP ALB DNS name before that)
# VITE_API_BASE_URL=https://api.gnanacomputech.com
